[Unit]
Description=Starggle LLM API 转发服务
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/installedAPP/StarggleAPI
Environment=STARGGLE_DEBUG=1
ExecStart=/home/installedAPP/StarggleAPI/venv/bin/uvicorn main:app --host 0.0.0.0 --port 9010
Restart=always
RestartSec=3
StandardOutput=append:/home/installedAPP/StarggleAPI/app.log
StandardError=append:/home/installedAPP/StarggleAPI/app.log

[Install]
WantedBy=multi-user.target
