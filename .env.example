# ==================== MySQL ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=starggle_main

# ==================== JWT（与 StarggleCom 共享） ====================
# 生产环境必须与 StarggleCom 使用同一个密钥，管理台登录 / 用户接口的 token 才能互通。
JWT_SECRET_KEY=change-me-to-the-same-secret-as-stargglecom

# 管理端白名单（逗号分隔的 user_id），必填。
# 留空时所有管理接口一律返回 403（fail-closed）。
ADMIN_USER_IDS=your-admin-user-id

# ==================== 业务开关 ====================
# 是否按会员等级校验每日调用次数（1 开启 / 0 关闭）
STARGGLE_ENFORCE_QUOTA=1

# 项目 Token：0=兼容旧调用；1=所有调用必须带 sk-gw- 项目 Token
# 无论开关如何，只要请求头带 sk-gw- 前缀都会校验。
GATEWAY_TOKEN_REQUIRED=0

# ==================== 服务 ====================
PORT=9010
GATEWAY_DEBUG=0

# 跨域管理台来源（逗号分隔）。页面与 API 同源时留空即可。
CORS_ORIGINS=https://www.starggle.com
