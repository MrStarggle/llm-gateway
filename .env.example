# ==================== 数据库 ====================
# 默认 SQLite：零配置，数据文件默认 data/gateway.db，适合单机/单进程部署。
DB_BACKEND=sqlite
# SQLITE_PATH=data/gateway.db

# 如需 MySQL：改成 DB_BACKEND=mysql 并填写下方连接信息。
# 也可以直接设置 DATABASE_URL（优先级最高），例如：
# DATABASE_URL=mysql+aiomysql://root:password@127.0.0.1:3306/llm_gateway?charset=utf8mb4
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=llm_gateway

# ==================== 管理员账号（JWT 登录） ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET_KEY=change-me-to-a-long-random-string

# ==================== 服务 ====================
PORT=9010
GATEWAY_DEBUG=0

# 跨域管理台来源（逗号分隔）。页面与 API 同源时留空即可。
CORS_ORIGINS=
