# ==================== 数据库 ====================
# 默认 SQLite：零配置，数据文件默认 data/gateway.db，适合单机/单进程部署。
DB_BACKEND=sqlite
# SQLITE_PATH=data/gateway.db

# 如需 MySQL：改成 DB_BACKEND=mysql 并填写下方连接信息。
# 也可以直接设置 DATABASE_URL（优先级最高），例如：
# DATABASE_URL=mysql+aiomysql://root:password@127.0.0.1:3306/llm_gateway?charset=utf8mb4
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=llm_gateway

# ==================== 管理员账号（JWT 登录） ====================
# 开源版为单管理员模式：账号密码明文保存在 env，不依赖用户表。
# 公开部署前请务必修改；接入自有用户体系时替换 auth_controller / admin_auth 即可。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_SECRET_KEY=change-me-to-a-long-random-string

# ==================== 项目 Token ====================
# 0：兼容旧调用，不带 Token 也可请求；1：所有调用必须带 sk-gw-... 项目 Token。
# 无论该开关如何，只要请求头带 sk-gw- 前缀，网关都会校验。
GATEWAY_TOKEN_REQUIRED=0

# ==================== 服务 ====================
# 启动脚本读取的端口；Docker 部署请改 docker-compose.yml 的端口映射。
PORT=9010
# 1 时错误响应包含调试信息；LLM 报文日志在管理台「渠道健康」切换（默认开启）。
GATEWAY_DEBUG=0

# 原始调用明细保留天数；0=不清理。项目每日聚合数据不删。
USAGE_RETENTION_DAYS=90

# 跨域管理台来源（逗号分隔）。页面与 API 同源时留空即可。
CORS_ORIGINS=
